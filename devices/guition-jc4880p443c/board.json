{
  "schema": 1,
  "id": "jc4880p443c",
  "name": "Guition JC4880P443C_I_W 4.3\" smart display",
  "vendor": "Guition (Shenzhen Jingcai)",
  "sku": "JC4880P443C_I_W",
  "module": "JC-ESP32P4-M3",
  "aliases": ["jc4880p443", "JC4880P443C"],

  "soc": {
    "target": "esp32p4",
    "silicon_rev_seen": "v1.3",
    "rev_min": "1.0",
    "rev_max": "1.99",
    "cpu_mhz": 360,
    "flash_mb": 16,
    "flash_chip": "Boya (generic driver)",
    "flash_mode": "qio",
    "flash_mhz": 80,
    "psram_mb": 32,
    "psram_mode": "octal/hex",
    "psram_mhz": 200
  },

  "coprocessor": {
    "chip": "esp32c6",
    "transport": "sdio",
    "sdio": { "slot": 1, "width": 4, "clk": 18, "cmd": 19, "d0": 14, "d1": 15, "d2": 16, "d3": 17, "freq_khz": 40000, "freq_khz_conservative": 20000 },
    "reset_gpio": 54,
    "reset_active_high": true,
    "factory_slave_version": "2.12.12",
    "expected_slave_version": "2.12.x",
    "capabilities": ["wlan", "hci-over-sdio", "ble-only"],
    "uart_recovery_header": "JP1 pins 18/20/22/24 (C6_U0RXD, C6_U0TXD, C6_IO9, C6_CHIP_PU)"
  },

  "display": {
    "diagonal_in": 4.3,
    "controller": "ST7701S",
    "interface": "mipi-dsi",
    "lanes": 2,
    "lane_mbps": 750,
    "dpi_mhz": 28,
    "native_w": 480,
    "native_h": 800,
    "portrait_native": true,
    "hsync": { "pulse": 12, "back_porch": 42, "front_porch": 42 },
    "vsync": { "pulse": 2, "back_porch": 8, "front_porch": 166 },
    "color_format": "RGB565",
    "frame_buffers": 2,
    "reset_gpio": 5,
    "backlight": { "gpio": 23, "driver": "MP3202 boost", "ledc_hz": 100, "max_duty_pct": 95 },
    "dsi_phy_ldo": { "channel": 3, "mv": 2500 },
    "bsp_kconfig": "CONFIG_BSP_LCD_TYPE_1024_600 (vendor repurposed this symbol for the 480x800 ST7701)"
  },

  "touch": {
    "controller": "GT911",
    "i2c_addr": "0x5D",
    "rst_gpio": null,
    "int_gpio": null,
    "int_wired": false,
    "polled": true,
    "firmware_upload": false,
    "points": 5,
    "transform": { "swap_xy": false, "mirror_x": false, "mirror_y": false },
    "driver": "espressif/esp_lcd_touch_gt911 (Apache-2.0, via the vendor BSP)"
  },

  "i2c": { "sda": 7, "scl": 8, "freq_hz": 100000, "freq_hz_max_proven": 400000, "shared_with": ["touch", "codec", "camera-sccb"] },

  "audio": {
    "codec": "ES8311",
    "codec_i2c_addr": "0x18",
    "amp": "NS4150 3 W class-D",
    "i2s": { "mclk": 13, "bclk": 12, "ws": 10, "dout": 9, "din": 48 },
    "pa_gpio": 11,
    "builtin_speaker": false,
    "speaker_connector": "MX1.25 2-pin (external speaker required)",
    "mic_count": 1,
    "mic_type": "analog MSM381A3729H9CP into the ES8311 ADC",
    "afe_input_format": "M",
    "defaults": { "volume": 70, "alarm_volume": 80, "mic_gain_db": 24, "digital_gain": 12 }
  },

  "camera": { "present": true, "sensor": "OV02C10", "sccb_addr": "0x36", "interface": "mipi-csi", "lanes": 1, "hflip": true, "mode_used": "RAW10 1288x728 30 fps (smallest mode; used as a light sensor)" },

  "sdcard": {
    "present": true,
    "bus": "sdmmc-4bit",
    "pins": { "d0": 39, "d1": 40, "d2": 41, "d3": 42, "cmd": 44, "clk": 43 },
    "power_ldo": { "channel": 4, "mv": 3300 },
    "note": "Without LDO channel 4 the card has no power: sdmmc_init_ocr returns 0x107"
  },

  "battery": { "connector": "MX1.25 2-pin (CN4)", "charger": "IP5306", "adc_gpio": 53, "adc_unit": 2, "adc_channel": 4, "divider_ratio": 0.595, "pin_mv_empty": 2250, "pin_mv_full": 2500 },

  "rtc": { "present": false },

  "usb": { "serial_jtag": true, "serial_jtag_socket": "the socket that enumerates as a COM port", "host_hs": true, "host_socket": "the other USB-C socket (high-speed controller)", "peripheral_map_note": "leave default; BIT0|BIT1 moves the host to the full-speed controller" },

  "console_uart": { "tx": 37, "rx": 38 },

  "other": { "rs485": { "uart": 1, "tx": 26, "rx": 27 }, "boot_button_gpio": 35, "reserved_gpios": [26, 27, 34, 35, 28, 29, 30, 31, 49, 50, 51, 52] },

  "ui": {
    "landscape_w": 800,
    "landscape_h": 480,
    "scale_q8": 256,
    "draw_buf_lines": 160,
    "fonts": { "hh": "dangrek_478", "mm": "dangrek_226", "body": "montserrat_16", "label": "montserrat_20", "title": "montserrat_28", "icon": "app_icons_28" }
  },

  "features": ["display", "touch", "wifi", "ble", "audio_out", "audio_in", "camera", "sdcard", "usb_host", "battery_adc", "rs485"],

  "revisions": [
    { "id": "v1.0", "note": "Only revision seen; schematic JC4880P443_V1.0. ESP32-P4 rev v1.3 silicon." }
  ],

  "status": {
    "verified_on": "2026-08-29",
    "runs": ["src/bedside_clock (daily use)", "src/sample_hello_world", "src/sample_wakeword_bench"],
    "host_com_port_on_author_pc": "COM3"
  },

  "sources": {
    "pins_and_timing": "devices/guition-jc4880p443c/docs/01-hardware.md; vendored BSP src/bedside_clock/components/espressif__esp32_p4_function_ev_board",
    "lane_rate_note": "The vendored BSP hard-codes 750 Mbps (esp32_p4_function_ev_board.c); ESPHome's JC4880P443 model uses 500 Mbps and DPI 34 MHz; both light the panel",
    "battery": "devices/guition-jc4880p443c/docs/interface-types.md",
    "vendor_package": "https://pan.jczn1688.com/directlink/1/HMI%20display/JC4880P443C_I_W.zip",
    "spec_pdf": "https://www.guition.com/-download (JC4880P443C_I_W Specifications-EN-V1.0.pdf)"
  }
}
