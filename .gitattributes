# Normalise line endings; scripts must stay LF for WSL/Git Bash
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text
*.c text
*.h text
*.cpp text
*.csv text
# binaries
*.bin binary
*.tflite binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.wav binary
*.mp3 binary
*.zip binary
*.rar binary
*.dwg binary
*.exe binary
