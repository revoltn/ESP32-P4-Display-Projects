# =============================================================================
# ESP32-P4 Guition displays repo - what never reaches the public tree
# =============================================================================

# ---- ESP-IDF build state (regenerated by idf.py; dependencies.lock IS committed) ----
build*/
managed_components/
sdkconfig
sdkconfig.old
sdkconfig.mww
sdkconfig.ref
# per-board generated configs (board-profiles plan) and local overrides; *.defaults stay tracked
sdkconfig.jc*
!sdkconfig.*.defaults
sdkconfig.local*
*.bak
dependencies.lock.pre-*

# ---- editors / tooling ----
.vscode/
.idea/
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# ---- local secrets: only the *.example.* templates are committed ----
secrets.h
*.local.h
*.local.py
*.local.yml
*.local.json
.env
.env.*

# SSH/TLS keys, certificates and credential stores must never be committed
id_rsa*
id_ed25519*
id_ecdsa*
*.pem
*.key
*.pfx
*.p12
*.jks
*.kdbx
.netrc
.npmrc
.git-credentials
# NVS / flash dumps carry stored WiFi and API credentials
*.nvs
nvs_dump*
flash_dump*
*.flashdump

# ---- captures / dumps ----
*.coredump
*.elfdump
*.raw.log

# ---- Third-party reference trees ----------------------------------------------
# Content stays on disk for local work; only our own README.md / inventory in each
# folder (upstream URL, version/commit, license, SHA256, why we keep it) is
# published, so authors get credit and nothing is redistributed without a grant.
reference/*/upstream/
reference/*/*.zip
devices/*/vendor/package/
devices/*/vendor/package-*/
devices/*/vendor/*.zip
devices/*/community/*/

# Vendor schematics, datasheets, CAD and factory/co-processor firmware images are
# linked (with SHA256) rather than hosted - no redistribution licence from Guition,
# Espressif or OmniVision.
devices/*/docs/schematics/*.webp
devices/*/docs/schematics/*.png
devices/*/docs/schematics/*.pdf
devices/*/firmware/*.bin
devices/*/firmware/*.zip

# ---- legacy top-level locations (pre-2026-10-02 layout; folders are moved into
#      the paths above, the rules stay so a stale checkout never commits them) ----
_archived/
demo_docs_specs/
demo-esphome-dev/
demo-espcontrol-main/
demos-docs-samples-2/
